# Secrets for `supabase functions serve --env-file supabase/functions/.env`.
# Copy to .env (gitignored) and fill in. In the hosted project these are set with
# `supabase secrets set NAME=value` instead — never committed either way.

# TMDb v4 read access token, used as `Authorization: Bearer`. NOT the v3 API key.
# https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=

# Salt for the HMAC over caller IPs. Any long random string; `openssl rand -hex 32`.
# Must differ between local and production, and must never be committed: a known salt
# makes every stored ip_hash brute-forceable across the 2^32 IPv4 space.
IP_HASH_SECRET=

# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by the platform — do not set
# them here. PLAY_INTEGRITY_SERVICE_ACCOUNT and APP_ATTEST_TEAM_ID are deliberately
# unset: the verifiers are stubs, so setting them would only mask a real "unavailable".
