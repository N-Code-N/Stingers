<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon, so Android can apply whatever mask the launcher uses without cropping
  the mark. The background is the same near-black as the launch window and the app
  itself; the foreground PNG is generated by tool/generate_app_icon.py, already inset to
  stay inside the 72dp safe zone.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/stingers_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
